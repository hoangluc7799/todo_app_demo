<section class="content-header">
    <div class="container-fluid">

        <div class="row mb-4 align-items-center">
            <div class="col-sm-6 d-flex align-items-center">
                <h1 class="m-0 mr-3">Danh sách công việc</h1>
                <a href="/admin/task/create" class="btn btn-success">
                    <i class="fas fa-plus"></i> Thêm công việc
                </a>
            </div>

            <div class="col-sm-6">
                <form action="/admin/manage-tasks" method="GET" class="form-inline justify-content-sm-end mt-2 mt-sm-0">
                    <div class="input-group" style="width: 100%; max-width: 350px;">
                        <input
                            type="text"
                            name="search"
                            class="form-control"
                            placeholder="Tìm kiếm công việc..."
                            value="{{searchKeyword}}">

                        <div class="input-group-append">
                            <button class="btn btn-primary" type="submit">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <table class="table" style="font-size: 1.1rem;">
            <thead>
                <tr>
                    <th style="width:60px">#</th>
                    <th>Tiêu đề</th>
                    <th>Mô tả</th>
                    <th>Hạn</th>
                    <th>Trạng thái</th>
                    <th>Người tạo</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>
                {{#each tasks}}
                <tr>
                    <td>{{sum @index 1}}</td>

                    <td>{{this.Title}}</td>

                    <td>{{this.Description}}</td>

                    <td>{{formatDate this.Duedate}}</td>

                    <td>{{this.Status0}}</td>

                    <td>
                        {{#if this.UserId}}
                            {{this.UserId.username}}
                        {{else}}
                            Không có
                        {{/if}}
                    </td>

                    <td>
                        <a href="/admin/task/{{this._id}}/edit" class="text-primary">Sửa</a>
                        |
                        <form action="/admin/task/{{this._id}}/delete" method="POST" style="display:inline;">
                            <button type="submit" 
                                    class="text-danger" 
                                    style="border:none; background:none; cursor:pointer;" 
                                    onclick="return confirm('Bạn có chắc chắn muốn xóa công việc này không?')">
                                Xóa
                            </button>
                        </form>
                    </td>
                </tr>

                {{else}}
                <tr>
                    <td colspan="7" class="text-center">
                        Chưa có công việc nào
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>


        {{#if showPagination}}
        <nav aria-label="Page navigation" class="my-4">
            <ul class="pagination pagination-md justify-content-center">
                

                <li class="page-item {{#unless hasPrev}}disabled{{/unless}}">
                    <a class="page-link rounded-start-pill px-3 shadow-sm" href="/admin/manage-tasks?page={{prevPage}}{{#if searchKeyword}}&search={{searchKeyword}}{{/if}}">
                        <i class="fas fa-chevron-left me-1"></i> Trước
                    </a>
                </li>

                <li class="page-item disabled mx-1">
                    <span class="page-link border-0 bg-transparent text-secondary fw-semibold d-flex align-items-center">
                        Trang {{currentPage}} / {{totalPages}}
                    </span>
                </li>


                <li class="page-item {{#unless hasNext}}disabled{{/unless}}">
                    <a class="page-link rounded-end-pill px-3 shadow-sm" href="/admin/manage-tasks?page={{nextPage}}{{#if searchKeyword}}&search={{searchKeyword}}{{/if}}">
                        Sau <i class="fas fa-chevron-right ms-1"></i>
                    </a>
                </li>

            </ul>
        </nav>
        {{/if}}

    </div>
</section>