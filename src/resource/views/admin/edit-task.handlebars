<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-info text-white"><h4>Sửa công việc</h4></div>
        <div class="card-body">
            <form action="/admin/task/{{task._id}}/edit?_method=PUT" method="POST">
                <div class="mb-3">
                    <label class="form-label">Tiêu đề</label>
                    <input type="text" name="Title" class="form-control" value="{{task.Title}}">
                </div>
                <div class="mb-3">
                    <label class="form-label">Mô tả</label>
                    <textarea name="Description" class="form-control">{{task.Description}}</textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Trạng thái</label>
                    <select name="Status0" class="form-select">
                        <option value="Chưa Hoàn Thành" {{#if (eq task.Status0 'Chưa Hoàn Thành')}}selected{{/if}}>Chưa Hoàn Thành</option>
                        <option value="Hoàng Thành" {{#if (eq task.Status0 'Hoàng Thành')}}selected{{/if}}>Hoàn Thành</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">Cập nhật</button>
                <a href="/task" class="btn btn-secondary">Hủy</a>
            </form>
        </div>
    </div>
</div>